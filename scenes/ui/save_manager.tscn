[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scenes/ui/save_manager.gd" id="1"]

[sub_resource type="StyleBoxFlat" id="panel_bg"]
bg_color = Color(0.12, 0.14, 0.18, 0.95)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.3, 0.35, 0.4, 1)
content_margin_left = 12.0
content_margin_top = 10.0
content_margin_right = 12.0
content_margin_bottom = 10.0

[node name="SaveManager" type="CanvasLayer"]
layer = 95
script = ExtResource("1")

[node name="Backdrop" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 0
color = Color(0, 0, 0, 0.75)

[node name="Panel" type="PanelContainer" parent="Backdrop"]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -150.0
offset_top = -155.0
offset_right = 150.0
offset_bottom = 155.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 0
theme_override_styles/panel = SubResource("panel_bg")

[node name="Layout" type="VBoxContainer" parent="Backdrop/Panel"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Title" type="Label" parent="Backdrop/Panel/Layout"]
layout_mode = 2
text = "存档管理"
horizontal_alignment = 1

[node name="Separator1" type="HSeparator" parent="Backdrop/Panel/Layout"]
layout_mode = 2

;; ---- Slot list (scrollable) ----
[node name="ScrollContainer" type="ScrollContainer" parent="Backdrop/Panel/Layout"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="SlotContainer" type="VBoxContainer" parent="Backdrop/Panel/Layout/ScrollContainer"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/separation = 2

[node name="Separator2" type="HSeparator" parent="Backdrop/Panel/Layout"]
layout_mode = 2

;; ---- Action buttons ----
[node name="Actions" type="HBoxContainer" parent="Backdrop/Panel/Layout"]
layout_mode = 2
theme_override_constants/separation = 8
alignment = 1

[node name="SaveButton" type="Button" parent="Backdrop/Panel/Layout/Actions"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(56, 0)
disabled = true
text = "存档"

[node name="LoadButton" type="Button" parent="Backdrop/Panel/Layout/Actions"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(56, 0)
disabled = true
text = "读档"

[node name="DeleteButton" type="Button" parent="Backdrop/Panel/Layout/Actions"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(56, 0)
disabled = true
text = "删档"

[node name="CloseButton" type="Button" parent="Backdrop/Panel/Layout"]
layout_mode = 2
text = "关闭"

;; ============ Connections ============
[connection signal="pressed" from="Backdrop/Panel/Layout/Actions/SaveButton" to="." method="_on_save_pressed"]
[connection signal="pressed" from="Backdrop/Panel/Layout/Actions/LoadButton" to="." method="_on_load_pressed"]
[connection signal="pressed" from="Backdrop/Panel/Layout/Actions/DeleteButton" to="." method="_on_delete_pressed"]
[connection signal="pressed" from="Backdrop/Panel/Layout/CloseButton" to="." method="_on_close_pressed"]
