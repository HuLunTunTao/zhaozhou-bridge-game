[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scenes/ui/settings_panel.gd" id="1"]

[sub_resource type="StyleBoxFlat" id="panel_bg"]
bg_color = Color(0.12, 0.14, 0.18, 0.95)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.3, 0.35, 0.4, 1)
content_margin_left = 16.0
content_margin_top = 12.0
content_margin_right = 16.0
content_margin_bottom = 12.0

[node name="SettingsPanel" type="CanvasLayer"]
layer = 90
script = ExtResource("1")

;; Dark overlay covering the entire screen
[node name="Backdrop" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 0
color = Color(0, 0, 0, 0.7)

;; Centered panel with opaque background
[node name="Panel" type="PanelContainer" parent="Backdrop"]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -130.0
offset_top = -130.0
offset_right = 130.0
offset_bottom = 130.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 0
theme_override_styles/panel = SubResource("panel_bg")

[node name="Content" type="VBoxContainer" parent="Backdrop/Panel"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="SettingsTitle" type="Label" parent="Backdrop/Panel/Content"]
layout_mode = 2
text = "设置"
horizontal_alignment = 1

[node name="Separator1" type="HSeparator" parent="Backdrop/Panel/Content"]
layout_mode = 2

;; ---- Audio Section ----
[node name="AudioSection" type="VBoxContainer" parent="Backdrop/Panel/Content"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="MusicRow" type="HBoxContainer" parent="Backdrop/Panel/Content/AudioSection"]
layout_mode = 2

[node name="MusicLabel" type="Label" parent="Backdrop/Panel/Content/AudioSection/MusicRow"]
layout_mode = 2
custom_minimum_size = Vector2(48, 0)
text = "音乐"

[node name="MusicSlider" type="HSlider" parent="Backdrop/Panel/Content/AudioSection/MusicRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
min_value = 0.0
max_value = 100.0
value = 80.0

[node name="SfxRow" type="HBoxContainer" parent="Backdrop/Panel/Content/AudioSection"]
layout_mode = 2

[node name="SfxLabel" type="Label" parent="Backdrop/Panel/Content/AudioSection/SfxRow"]
layout_mode = 2
custom_minimum_size = Vector2(48, 0)
text = "音效"

[node name="SfxSlider" type="HSlider" parent="Backdrop/Panel/Content/AudioSection/SfxRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
min_value = 0.0
max_value = 100.0
value = 80.0

[node name="Separator2" type="HSeparator" parent="Backdrop/Panel/Content"]
layout_mode = 2

;; ---- Save Section ----
[node name="SaveManagerButton" type="Button" parent="Backdrop/Panel/Content"]
layout_mode = 2
text = "存档管理"

[node name="Separator3" type="HSeparator" parent="Backdrop/Panel/Content"]
layout_mode = 2

;; ---- In-game only buttons ----
[node name="QuickSaveButton" type="Button" parent="Backdrop/Panel/Content"]
unique_name_in_owner = true
layout_mode = 2
visible = false
text = "快速存档"

[node name="RestartButton" type="Button" parent="Backdrop/Panel/Content"]
unique_name_in_owner = true
layout_mode = 2
visible = false
text = "重新开始"

[node name="BackToMenuButton" type="Button" parent="Backdrop/Panel/Content"]
unique_name_in_owner = true
layout_mode = 2
visible = false
text = "返回主菜单"

;; ---- Close ----
[node name="CloseButton" type="Button" parent="Backdrop/Panel/Content"]
layout_mode = 2
text = "关闭"

;; ============ Connections ============
[connection signal="value_changed" from="Backdrop/Panel/Content/AudioSection/MusicRow/MusicSlider" to="." method="_on_music_slider_value_changed"]
[connection signal="value_changed" from="Backdrop/Panel/Content/AudioSection/SfxRow/SfxSlider" to="." method="_on_sfx_slider_value_changed"]
[connection signal="pressed" from="Backdrop/Panel/Content/SaveManagerButton" to="." method="_on_save_manager_pressed"]
[connection signal="pressed" from="Backdrop/Panel/Content/QuickSaveButton" to="." method="_on_quick_save_pressed"]
[connection signal="pressed" from="Backdrop/Panel/Content/RestartButton" to="." method="_on_restart_pressed"]
[connection signal="pressed" from="Backdrop/Panel/Content/BackToMenuButton" to="." method="_on_back_to_menu_pressed"]
[connection signal="pressed" from="Backdrop/Panel/Content/CloseButton" to="." method="_on_close_pressed"]
