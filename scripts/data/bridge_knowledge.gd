## 按 key 取一条。
static func get_topic(key: String) -> Dictionary:
	for t in TOPICS:
		if t.get("key", "") == key:
			return t
	return {}


## 返回所有 key 数组（顺序同 TOPICS）。
static func all_keys() -> Array[String]:
	var keys: Array[String] = []
	for t in TOPICS:
		keys.append(String(t.get("key", "")))
	return keys


## 给 LLM prompt 用：返回所有 key→title 映射，让它选 topic_key。
static func key_to_title_csv() -> String:
	var lines: Array[String] = []
	for t in TOPICS:
		lines.append("%s（%s）" % [t.get("key", ""), t.get("title", "")])
	return ", ".join(lines)
