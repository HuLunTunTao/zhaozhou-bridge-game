	"style": "土气直白，短句为主。",
	"tags": ["友军", "兜底"],
}

const FALLBACK_ENEMY := {
	"name": "未名妖物",
	"persona": "你是洨水上冒出来的无名妖物，没有清晰的形貌。",
	"style": "含糊、怪诞，不成句。",
