## 按 unit_id 取人设。查不到则按 camp 回落到通用匠人/妖物。
static func get_persona(unit_id: String, camp: int = 0) -> Dictionary:
	if PERSONAS.has(unit_id):
		return PERSONAS[unit_id]
	if camp == Enums.Camp.ENEMY:
		return FALLBACK_ENEMY
	return FALLBACK_ALLY
