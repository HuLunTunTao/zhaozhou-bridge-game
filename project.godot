; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="game"
run/main_scene="res://scenes/menu/main_menu.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
boot_splash/bg_color=Color(0.08, 0.06, 0.04, 1)
boot_splash/image="res://assets/background.png"
config/icon="res://assets/logo.png"

[audio]

buses/default_bus_layout="uid://c6nl13ad7abrc"

[autoload]

GameState="*res://scripts/game_state.gd"
Notify="*res://scripts/notification_manager.gd"
TestBridge="*uid://iorf7f2xmkmt"
Settings="*res://scripts/settings.gd"
Progress="*res://scripts/progress.gd"
BgmManager="*res://scripts/audio/bgm_manager.gd"
SfxManager="*res://scripts/audio/sfx_manager.gd"
UiSounds="*res://scripts/audio/ui_sounds.gd"
TtsFallbackIndex="*res://scripts/tts/tts_fallback_index.gd"
SaveSlots="*res://scripts/save_slots.gd"
TutorialTtsIndex="*res://scripts/tts/tutorial_tts_index.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="game"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_test_bridge/plugin.cfg", "res://addons/godot_volcengine_tts/plugin.cfg")

[gui]

theme/custom_font="uid://cpshydexpd30i"

[input]

up={
